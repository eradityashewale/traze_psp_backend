# Copy to .env and adjust. Never commit .env.

# --- Environment (checklist 1.2 / 1.3): local | uat | production ---
# uat/production refuse to start with unsafe settings (see README).
ENVIRONMENT=local
PUBLIC_API_BASE_URL=http://localhost:8000
# e.g. https://<uat-host>/PSPtestadmin/
ADMIN_PORTAL_URL=

# MySQL 8: either DB_* values or a full DATABASE_URL (which wins).
# The database is created on first start if it does not exist.
DB_NAME=psp_portal
DB_USER=root
DB_PASS=YOUR_PASSWORD
DB_HOST=localhost:3306
# Apply pending database migrations automatically at startup
RUN_MIGRATIONS_ON_STARTUP=true
# DATABASE_URL=mysql://root:YOUR_PASSWORD@localhost:3306/psp_portal

# Long random string, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRES_MINUTES=60

# First admin account, created on startup only if no portal users exist yet
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

# --- HTTPS (checklist 2 / 8) ---
ENFORCE_HTTPS=false
TRUST_FORWARDED_PROTO=true
MIN_RSA_KEY_BITS=2048

# --- API token rotation (checklist 5) ---
API_TOKEN_VALIDITY_DAYS=90
ROTATION_GRACE_HOURS=72

# --- MD5 request signing (checklist 6) ---
REQUIRE_SIGNATURE=true
SIGNATURE_MAX_SKEW_SECONDS=300

# --- Public / private key (checklist 7) ---
PORTAL_PRIVATE_KEY_PATH=keys/portal_private_key.pem

# --- Login protection ---
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- Callbacks to the CRM (checklist 4 / 11) ---
CALLBACK_TIMEOUT_SECONDS=10
CALLBACK_MAX_RETRIES=3
# Only for local testing: allow http:// callback URLs
ALLOW_HTTP_CALLBACKS=false

# --- Screenshot storage (S3) ---
# Private bucket for deposit / withdrawal screenshots. Uploads are refused while S3_BUCKET is empty.
S3_BUCKET=
AWS_REGION=ap-south-1
# Local runs only. On EC2 leave both empty and attach an IAM role to the instance.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# How long the view links in API responses stay valid
S3_URL_EXPIRES_SECONDS=900
SCREENSHOT_MAX_MB=5

# --- Questionnaire answers (checklist 10-13) ---
PCI_DSS_LEVEL=To be confirmed with the PSP team
DR_DESCRIPTION=Secondary DR site; failover is automatic on the PSP side, API URLs do not change
MONITORING_CHANNEL=Skype/WhatsApp group shared at onboarding; GET /health/ready; error codes at /api/v1/meta/error-codes
SUPPORT_TECHNICAL=
SUPPORT_BUSINESS=
SUPPORT_CUSTOMER_SERVICE=

# Comma-separated list of origins for the portal frontend
CORS_ORIGINS=http://localhost:3000
